[Unit]
Description=Qodo factory: one step of the ticket loop (scripts/agent-watch.mjs)

[Service]
Type=oneshot
# a run waits for Qodo and the agent inside one start. The worst legitimate run is about 17 h
# (7 pushes, each up to 2 agent runs of 45 min plus tests), so only a hang reaches 24 h. If it's
# killed, the next tick finds the ticket mid-run and stops it with agent-needs-help.
TimeoutStartSec=24h
WorkingDirectory=%h/qodo-hack-2026
# node lives under the home directory, not in systemd's default PATH. A machine-specific PATH (for
# example where claude is installed) goes in the uncommitted ~/.config/qodo-agent/env, which overrides this
Environment=PATH=%h/.nvm/versions/node/v25.2.1/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/qodo-agent/env
# run the merged copy from origin/main, not whatever branch the working checkout is on
ExecStartPre=/usr/bin/git -C %h/qodo-hack-2026 fetch -q origin main
# the whole scripts folder, so a new runner module never needs a unit change (Qodo on #104)
ExecStartPre=/bin/sh -c 'S=%h/.local/state/qodo-agent && mkdir -p $$S && git -C %h/qodo-hack-2026 archive -o $$S/scripts.tar origin/main scripts && tar -x -f $$S/scripts.tar -C $$S --strip-components=1'
ExecStart=%h/.nvm/versions/node/v25.2.1/bin/node %h/.local/state/qodo-agent/agent-watch.mjs
